{
  "plugins": [
    "expo-asset",
    "expo-font",
    [
      "expo-splash-screen",
      {
        "image": "./assets/splash.png",
        "imageWidth": 180,
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF",
        "dark": {
          "image": "./assets/splash-dark.png",
          "backgroundColor": "#000000"
        }
      }
    ]
  ],
  "icon": "./assets/icon.png",
  "backgroundColor": "#FFFFFF",
  "android": {
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#0B0B0C",
      "monochromeImage": "./assets/monochrome-icon.png"
    },
    "intentFilters": [
      {
        "action": "VIEW",
        "category": [
          "DEFAULT"
        ],
        "data": [
          {
            "scheme": "content",
            "mimeType": "*/*",
            "pathPattern": ".*\\.smd"
          },
          {
            "scheme": "file",
            "mimeType": "*/*",
            "pathPattern": ".*\\.smd"
          },
          {
            "scheme": "content",
            "mimeType": "*/*",
            "pathPattern": ".*\\.md"
          },
          {
            "scheme": "file",
            "mimeType": "*/*",
            "pathPattern": ".*\\.md"
          },
          {
            "scheme": "content",
            "mimeType": "*/*",
            "pathPattern": ".*\\.txt"
          },
          {
            "scheme": "file",
            "mimeType": "*/*",
            "pathPattern": ".*\\.txt"
          },
          {
            "scheme": "content",
            "mimeType": "*/*",
            "pathPattern": ".*\\.csv"
          },
          {
            "scheme": "file",
            "mimeType": "*/*",
            "pathPattern": ".*\\.csv"
          },
          {
            "scheme": "content",
            "mimeType": "*/*",
            "pathPattern": ".*\\.pdf"
          },
          {
            "scheme": "file",
            "mimeType": "*/*",
            "pathPattern": ".*\\.pdf"
          },
          {
            "scheme": "content",
            "mimeType": "*/*",
            "pathPattern": ".*\\.docx"
          },
          {
            "scheme": "file",
            "mimeType": "*/*",
            "pathPattern": ".*\\.docx"
          },
          {
            "scheme": "content",
            "mimeType": "*/*",
            "pathPattern": ".*\\.xlsx"
          },
          {
            "scheme": "file",
            "mimeType": "*/*",
            "pathPattern": ".*\\.xlsx"
          },
          {
            "scheme": "content",
            "mimeType": "*/*",
            "pathPattern": ".*\\.pptx"
          },
          {
            "scheme": "file",
            "mimeType": "*/*",
            "pathPattern": ".*\\.pptx"
          },
          {
            "scheme": "content",
            "mimeType": "*/*",
            "pathPattern": ".*\\.odt"
          },
          {
            "scheme": "file",
            "mimeType": "*/*",
            "pathPattern": ".*\\.odt"
          },
          {
            "scheme": "content",
            "mimeType": "*/*",
            "pathPattern": ".*\\.rtf"
          },
          {
            "scheme": "file",
            "mimeType": "*/*",
            "pathPattern": ".*\\.rtf"
          },
          {
            "scheme": "content",
            "mimeType": "*/*",
            "pathPattern": ".*\\.epub"
          },
          {
            "scheme": "file",
            "mimeType": "*/*",
            "pathPattern": ".*\\.epub"
          }
        ]
      }
    ],
    "package": "com.helloworld",
    "versionCode": 2
  },
  "name": "Supreader",
  "slug": "supreader",
  "ios": {
    "bundleIdentifier": "com.supreader.app"
  },
  "userInterfaceStyle": "automatic",
  "version": "1.1.0"
}